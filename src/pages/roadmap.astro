---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/astro/Header.astro";
import Footer from "../components/astro/Footer.astro";
import RoadmapGame from "../components/react/RoadmapGame";
import { getLangFromUrl, t } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
---

<BaseLayout
  title={t("roadmap.meta.title", lang)}
  description={t("roadmap.meta.description", lang)}
>
  <Header />
  <main id="main" class="pt-20 min-h-screen">
    <RoadmapGame client:load lang={lang} />
  </main>
  <Footer />
</BaseLayout>
