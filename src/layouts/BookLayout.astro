---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import AnalyticsBeacon from "../components/astro/AnalyticsBeacon.astro";

interface Props {
  title?: string;
  chapter?: string;
  subtitle?: string;
}

const { title = "L4tentNoise", chapter = "", subtitle = "" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1a1a1a" />
    <title>{chapter ? `${chapter} — ${title}` : title}</title>
    <ClientRouter />
    <style is:global>
      @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=JetBrains+Mono:wght@300;400&display=swap');

      :root {
        --book-bg: #141418;
        --book-bg-page: #1a1a20;
        --book-text: #d4d0c8;
        --book-text-dim: #8a8780;
        --book-accent: #c9a84c;
        --book-accent-dim: rgba(201, 168, 76, 0.15);
        --book-red: #b44;
        --book-green: #4a8;
        --book-cyan: #5bb;
        --book-border: rgba(201, 168, 76, 0.12);
        --book-serif: 'Cormorant Garamond', 'Georgia', serif;
        --book-mono: 'JetBrains Mono', monospace;
      }

      body.book-body {
        background: var(--book-bg);
        color: var(--book-text);
        font-family: var(--book-serif);
        font-size: 1.15rem;
        line-height: 1.85;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
      }

      .book-page {
        max-width: 720px;
        margin: 0 auto;
        padding: 3rem 2rem 6rem;
      }

      .book-header {
        text-align: center;
        padding: 4rem 0 3rem;
        border-bottom: 1px solid var(--book-border);
        margin-bottom: 3rem;
      }
      .book-chapter-label {
        font-family: var(--book-mono);
        font-size: 0.65rem;
        letter-spacing: 0.35em;
        text-transform: uppercase;
        color: var(--book-accent);
        margin-bottom: 1rem;
      }
      .book-chapter-title {
        font-family: var(--book-serif);
        font-size: 2.8rem;
        font-weight: 700;
        color: var(--book-text);
        line-height: 1.15;
        letter-spacing: -0.01em;
      }
      .book-chapter-subtitle {
        font-family: var(--book-serif);
        font-size: 1.1rem;
        font-style: italic;
        color: var(--book-text-dim);
        margin-top: 0.75rem;
      }

      .book-section-sep {
        text-align: center;
        padding: 2.5rem 0;
        font-family: var(--book-serif);
        font-size: 1.4rem;
        font-weight: 600;
        color: var(--book-accent);
        letter-spacing: 0.1em;
      }
      .book-section-sep::before,
      .book-section-sep::after {
        content: '';
        display: inline-block;
        width: 40px;
        height: 1px;
        background: var(--book-border);
        vertical-align: middle;
        margin: 0 1rem;
      }

      .book-prose p {
        margin-bottom: 1.5rem;
        text-align: justify;
        hyphens: auto;
      }

      .book-prose em {
        color: rgba(212, 208, 200, 0.75);
        font-style: italic;
      }

      .book-prose strong {
        color: var(--book-text);
        font-weight: 600;
      }

      .book-prose hr {
        border: none;
        text-align: center;
        margin: 2.5rem 0;
      }
      .book-prose hr::after {
        content: '* * *';
        font-family: var(--book-serif);
        font-size: 1rem;
        color: var(--book-text-dim);
        letter-spacing: 0.5em;
      }

      .book-hud {
        font-family: var(--book-mono);
        font-size: 0.7rem;
        line-height: 1.7;
        background: rgba(10, 10, 15, 0.6);
        border: 1px solid var(--book-border);
        border-left: 3px solid var(--book-accent);
        padding: 1.25rem 1.5rem;
        margin: 2.5rem 0;
        color: var(--book-text-dim);
        border-radius: 2px;
      }
      .book-hud .hud-label { color: var(--book-accent); }
      .book-hud .hud-value { color: var(--book-green); }
      .book-hud .hud-alert { color: var(--book-red); }

      .book-terminal {
        font-family: var(--book-mono);
        font-size: 0.78rem;
        line-height: 1.6;
        background: rgba(10, 10, 15, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.06);
        padding: 1.25rem 1.5rem;
        margin: 2rem 0;
        color: var(--book-cyan);
        border-radius: 2px;
        overflow-x: auto;
      }

      .book-voice {
        font-family: var(--book-mono);
        font-size: 0.78rem;
        line-height: 1.75;
        background: rgba(8, 8, 12, 0.85);
        border: 1px solid rgba(180, 68, 68, 0.2);
        border-left: 3px solid var(--book-red);
        padding: 1.25rem 1.5rem;
        margin: 2.5rem 0;
        color: #b8a898;
        border-radius: 2px;
        position: relative;
      }
      .book-voice::before {
        content: 'VOICE_LOG :: ???';
        position: absolute;
        top: -9px;
        left: 16px;
        background: var(--book-bg);
        padding: 0 8px;
        font-size: 0.55rem;
        letter-spacing: 0.3em;
        color: var(--book-red);
        font-weight: 600;
      }
      .book-voice.named::before {
        content: 'VOICE_LOG :: L4TENTNOISE';
        color: var(--book-accent);
      }
      .book-voice p {
        margin: 0 0 0.35rem 0;
        text-align: left;
        hyphens: none;
      }
      .book-voice p:last-child { margin-bottom: 0; }
      .book-voice .v-prompt {
        color: var(--book-red);
        margin-right: 0.4rem;
      }
      .book-voice.named .v-prompt {
        color: var(--book-accent);
      }

      .book-decisions {
        margin: 3rem 0;
        padding: 2rem 0;
        border-top: 1px solid var(--book-border);
        border-bottom: 1px solid var(--book-border);
      }
      .book-decisions h3 {
        font-family: var(--book-mono);
        font-size: 0.7rem;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--book-accent);
        margin-bottom: 1.5rem;
        text-align: center;
      }
      .book-decision-card {
        background: var(--book-accent-dim);
        border: 1px solid var(--book-border);
        border-radius: 4px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
      }
      .book-decision-card:hover {
        border-color: var(--book-accent);
        background: rgba(201, 168, 76, 0.1);
        transform: translateX(4px);
      }
      .book-decision-label {
        font-family: var(--book-mono);
        font-size: 0.65rem;
        letter-spacing: 0.2em;
        color: var(--book-accent);
        margin-bottom: 0.5rem;
      }
      .book-decision-title {
        font-family: var(--book-serif);
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--book-text);
        margin-bottom: 0.5rem;
      }
      .book-decision-desc {
        font-size: 0.95rem;
        color: var(--book-text-dim);
        line-height: 1.6;
      }

      .book-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2rem 0;
        margin-top: 3rem;
        border-top: 1px solid var(--book-border);
        font-family: var(--book-mono);
        font-size: 0.7rem;
      }
      .book-nav a {
        color: var(--book-accent);
        text-decoration: none;
        letter-spacing: 0.1em;
        transition: opacity 0.2s;
      }
      .book-nav a:hover { opacity: 0.7; }

      .book-topbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        background: rgba(20, 20, 24, 0.92);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--book-border);
        padding: 0.6rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: var(--book-mono);
        font-size: 0.6rem;
        letter-spacing: 0.15em;
        color: var(--book-text-dim);
      }
      .book-topbar a {
        color: var(--book-accent);
        text-decoration: none;
      }

      .book-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 2px;
        background: var(--book-accent);
        z-index: 60;
        transition: width 0.1s linear;
      }

      .book-drop-cap p:first-of-type::first-letter {
        font-size: 3.2em;
        float: left;
        line-height: 0.8;
        padding-right: 0.12em;
        padding-top: 0.08em;
        font-weight: 700;
        color: var(--book-accent);
      }

      @media (max-width: 640px) {
        .book-page { padding: 2rem 1.25rem 4rem; }
        .book-chapter-title { font-size: 2rem; }
        body.book-body { font-size: 1.05rem; }
        .book-drop-cap p:first-of-type::first-letter { font-size: 2.5em; }
      }
    </style>
  </head>
  <body class="book-body">
    <div class="book-progress" id="readingProgress"></div>

    <div class="book-topbar">
      <a href="/l4tentnoise/book">L4TENTNOISE</a>
      <span id="chapterIndicator">{chapter}</span>
      <span id="readTime"></span>
    </div>

    <div class="book-page">
      <slot />
    </div>

    <script>
      function updateProgress() {
        const el = document.getElementById('readingProgress');
        if (!el) return;
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        el.style.width = pct + '%';
      }
      window.addEventListener('scroll', updateProgress, { passive: true });

      function setReadTime() {
        const el = document.getElementById('readTime');
        if (!el) return;
        const text = document.querySelector('.book-prose')?.textContent || '';
        const words = text.trim().split(/\s+/).length;
        const minutes = Math.ceil(words / 200);
        el.textContent = minutes + ' min lectura';
      }
      setReadTime();
    </script>
    <AnalyticsBeacon />
  </body>
</html>
