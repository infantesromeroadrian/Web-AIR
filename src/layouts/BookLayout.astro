---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import AnalyticsBeacon from "../components/astro/AnalyticsBeacon.astro";

interface Props {
  title?: string;
  chapter?: string;
  subtitle?: string;
}

const { title = "L4tentNoise", chapter = "", subtitle = "" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#1a1a1a" />
    <title>{chapter ? `${chapter} — ${title}` : title}</title>
    <ClientRouter />
    <style is:global>
      @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=JetBrains+Mono:wght@300;400&display=swap');

      :root {
        --book-bg: #141418;
        --book-bg-page: #1a1a20;
        --book-text: #d4d0c8;
        --book-text-dim: #8a8780;
        --book-accent: #c9a84c;
        --book-accent-dim: rgba(201, 168, 76, 0.15);
        --book-red: #b44;
        --book-green: #4a8;
        --book-cyan: #5bb;
        --book-border: rgba(201, 168, 76, 0.12);
        --book-serif: 'Cormorant Garamond', 'Georgia', serif;
        --book-mono: 'JetBrains Mono', monospace;
      }

      body.book-body {
        background: var(--book-bg);
        color: var(--book-text);
        font-family: var(--book-serif);
        font-size: 1.15rem;
        line-height: 1.85;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
      }

      .book-page {
        max-width: 720px;
        margin: 0 auto;
        padding: 3rem 2rem 6rem;
      }

      .book-header {
        text-align: center;
        padding: 4rem 0 3rem;
        border-bottom: 1px solid var(--book-border);
        margin-bottom: 3rem;
      }
      .book-chapter-label {
        font-family: var(--book-mono);
        font-size: 0.65rem;
        letter-spacing: 0.35em;
        text-transform: uppercase;
        color: var(--book-accent);
        margin-bottom: 1rem;
      }
      .book-chapter-title {
        font-family: var(--book-serif);
        font-size: 2.8rem;
        font-weight: 700;
        color: var(--book-text);
        line-height: 1.15;
        letter-spacing: -0.01em;
      }
      .book-chapter-subtitle {
        font-family: var(--book-serif);
        font-size: 1.1rem;
        font-style: italic;
        color: var(--book-text-dim);
        margin-top: 0.75rem;
      }

      .book-section-sep {
        text-align: center;
        padding: 2.5rem 0;
        font-family: var(--book-serif);
        font-size: 1.4rem;
        font-weight: 600;
        color: var(--book-accent);
        letter-spacing: 0.1em;
      }
      .book-section-sep::before,
      .book-section-sep::after {
        content: '';
        display: inline-block;
        width: 40px;
        height: 1px;
        background: var(--book-border);
        vertical-align: middle;
        margin: 0 1rem;
      }

      .book-prose p {
        margin-bottom: 1.5rem;
        text-align: justify;
        hyphens: auto;
      }

      .book-prose em {
        color: rgba(212, 208, 200, 0.75);
        font-style: italic;
      }

      .book-prose strong {
        color: var(--book-text);
        font-weight: 600;
      }

      .book-prose hr {
        border: none;
        text-align: center;
        margin: 2.5rem 0;
      }
      .book-prose hr::after {
        content: '* * *';
        font-family: var(--book-serif);
        font-size: 1rem;
        color: var(--book-text-dim);
        letter-spacing: 0.5em;
      }

      .book-hud {
        font-family: var(--book-mono);
        font-size: 0.7rem;
        line-height: 1.7;
        background: rgba(10, 10, 15, 0.6);
        border: 1px solid var(--book-border);
        border-left: 3px solid var(--book-accent);
        padding: 1.25rem 1.5rem;
        margin: 2.5rem 0;
        color: var(--book-text-dim);
        border-radius: 2px;
      }
      .book-hud .hud-label { color: var(--book-accent); }
      .book-hud .hud-value { color: var(--book-green); }
      .book-hud .hud-alert { color: var(--book-red); }

      .book-terminal {
        font-family: var(--book-mono);
        font-size: 0.78rem;
        line-height: 1.6;
        background: rgba(10, 10, 15, 0.8);
        border: 1px solid rgba(255, 255, 255, 0.06);
        padding: 1.25rem 1.5rem;
        margin: 2rem 0;
        color: var(--book-cyan);
        border-radius: 2px;
        overflow-x: auto;
      }

      .book-decisions {
        margin: 3rem 0;
        padding: 2rem 0;
        border-top: 1px solid var(--book-border);
        border-bottom: 1px solid var(--book-border);
      }
      .book-decisions h3 {
        font-family: var(--book-mono);
        font-size: 0.7rem;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--book-accent);
        margin-bottom: 1.5rem;
        text-align: center;
      }
      .book-decision-card {
        background: var(--book-accent-dim);
        border: 1px solid var(--book-border);
        border-radius: 4px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
      }
      .book-decision-card:hover {
        border-color: var(--book-accent);
        background: rgba(201, 168, 76, 0.1);
        transform: translateX(4px);
      }
      .book-decision-label {
        font-family: var(--book-mono);
        font-size: 0.65rem;
        letter-spacing: 0.2em;
        color: var(--book-accent);
        margin-bottom: 0.5rem;
      }
      .book-decision-title {
        font-family: var(--book-serif);
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--book-text);
        margin-bottom: 0.5rem;
      }
      .book-decision-desc {
        font-size: 0.95rem;
        color: var(--book-text-dim);
        line-height: 1.6;
      }

      .book-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2rem 0;
        margin-top: 3rem;
        border-top: 1px solid var(--book-border);
        font-family: var(--book-mono);
        font-size: 0.7rem;
      }
      .book-nav a {
        color: var(--book-accent);
        text-decoration: none;
        letter-spacing: 0.1em;
        transition: opacity 0.2s;
      }
      .book-nav a:hover { opacity: 0.7; }

      .book-topbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 50;
        background: rgba(20, 20, 24, 0.92);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--book-border);
        padding: 0.6rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: var(--book-mono);
        font-size: 0.6rem;
        letter-spacing: 0.15em;
        color: var(--book-text-dim);
      }
      .book-topbar a {
        color: var(--book-accent);
        text-decoration: none;
      }

      .book-progress {
        position: fixed;
        top: 0;
        left: 0;
        height: 2px;
        background: var(--book-accent);
        z-index: 60;
        transition: width 0.1s linear;
      }

      .book-drop-cap p:first-of-type::first-letter {
        font-size: 3.2em;
        float: left;
        line-height: 0.8;
        padding-right: 0.12em;
        padding-top: 0.08em;
        font-weight: 700;
        color: var(--book-accent);
      }

      @media (max-width: 640px) {
        .book-page { padding: 2rem 1.25rem 4rem; }
        .book-chapter-title { font-size: 2rem; }
        body.book-body { font-size: 1.05rem; }
        .book-drop-cap p:first-of-type::first-letter { font-size: 2.5em; }
      }
    </style>
  </head>
  <body class="book-body">
    <!-- Gate overlay -->
    <div id="l4gate" style="position:fixed;inset:0;z-index:9999;background:#0a0a0f;display:flex;align-items:center;justify-content:center;font-family:'JetBrains Mono',monospace;">
      <div style="width:100%;max-width:440px;padding:0 1.5rem;">
        <div style="border:1px solid rgba(255,255,255,0.08);border-radius:8px;background:rgba(18,18,26,0.9);padding:2rem;">
          <div style="font-size:0.6rem;letter-spacing:0.3em;color:#ef4444;margin-bottom:1.5rem;display:flex;align-items:center;gap:8px;">
            <span style="width:6px;height:6px;border-radius:50%;background:#ef4444;display:inline-block;animation:gatepulse 2s ease-in-out infinite;"></span>
            RESTRICTED ACCESS
          </div>
          <div style="font-size:0.75rem;color:#71717a;margin-bottom:0.5rem;line-height:1.6;">
            <span style="color:#06b6d4;">$</span> ssh root@l4tentnoise.local<br/>
            <span style="color:#10b981;">Connection established.</span><br/>
            <span>Enter access code to continue:</span>
          </div>
          <form id="l4form" style="margin-top:1rem;">
            <div style="display:flex;align-items:center;gap:8px;">
              <span style="color:#06b6d4;font-size:0.8rem;">></span>
              <input id="l4input" type="password" placeholder="access_code" autocomplete="off" style="flex:1;background:transparent;border:none;outline:none;color:#e4e4e7;font-family:inherit;font-size:0.85rem;caret-color:#06b6d4;"/>
            </div>
            <div id="l4line" style="height:1px;background:rgba(255,255,255,0.08);margin-top:4px;transition:background 0.3s;"></div>
          </form>
          <div id="l4error" style="margin-top:0.75rem;font-size:0.65rem;color:#ef4444;letter-spacing:0.1em;display:none;">ACCESS DENIED</div>
          <div style="margin-top:1.5rem;font-size:0.55rem;color:rgba(113,113,122,0.4);text-align:center;">This session is monitored.</div>
        </div>
      </div>
      <style>@keyframes gatepulse{0%,100%{opacity:1}50%{opacity:0.3}}</style>
    </div>

    <!-- Actual content (hidden until auth) -->
    <div id="l4content" style="display:none;">
      <div class="book-progress" id="readingProgress"></div>

      <div class="book-topbar">
        <a href="/l4tentnoise/book">L4TENTNOISE</a>
        <span id="chapterIndicator">{chapter}</span>
        <span id="readTime"></span>
      </div>

      <div class="book-page">
        <slot />
      </div>
    </div>

    <script is:inline>
      (function(){
        var K="l4tent_access",H="a7f3b2c1d4e5";
        var E=[76,52,116,101,110,116,78,111,105,115,101,55,49,51,52];
        if(sessionStorage.getItem(K)===H){
          document.getElementById("l4gate").style.display="none";
          document.getElementById("l4content").style.display="block";
        } else {
          document.getElementById("l4input").focus();
        }
        document.getElementById("l4form").addEventListener("submit",function(e){
          e.preventDefault();
          var v=document.getElementById("l4input").value;
          var ok=v.length===E.length;
          if(ok){for(var i=0;i<E.length;i++){if(v.charCodeAt(i)!==E[i])ok=false;}}
          if(ok){
            sessionStorage.setItem(K,H);
            document.getElementById("l4gate").style.display="none";
            document.getElementById("l4content").style.display="block";
          } else {
            document.getElementById("l4error").style.display="block";
            document.getElementById("l4line").style.background="#ef4444";
            document.getElementById("l4input").value="";
            setTimeout(function(){
              document.getElementById("l4error").style.display="none";
              document.getElementById("l4line").style.background="rgba(255,255,255,0.08)";
            },1500);
          }
        });
      })();
    </script>

    <script>
      function updateProgress() {
        const el = document.getElementById('readingProgress');
        if (!el) return;
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        el.style.width = pct + '%';
      }
      window.addEventListener('scroll', updateProgress, { passive: true });

      function setReadTime() {
        const el = document.getElementById('readTime');
        if (!el) return;
        const text = document.querySelector('.book-prose')?.textContent || '';
        const words = text.trim().split(/\s+/).length;
        const minutes = Math.ceil(words / 200);
        el.textContent = minutes + ' min lectura';
      }
      setReadTime();
    </script>
    <AnalyticsBeacon />
  </body>
</html>
