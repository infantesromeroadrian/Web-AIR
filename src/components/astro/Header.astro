---
import { getLangFromUrl, pathForLang } from "../../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const es = lang === "es";
const homePath = es ? "/es/" : "/";
const otherPath = pathForLang(Astro.url, es ? "en" : "es");
const onHome = Astro.url.pathname === homePath;
const links = [
  { label: es ? "Trabajo" : "Work", href: `${onHome ? "" : homePath}#work` },
  { label: es ? "Perfil" : "Profile", href: `${onHome ? "" : homePath}#profile` },
  { label: es ? "Contacto" : "Contact", href: `${onHome ? "" : homePath}#contact` },
];
---
<header class="site-header" data-site-header>
  <nav class="content-wrap site-nav" aria-label={es ? "Navegación principal" : "Main navigation"}>
    <a href={homePath} class="site-logo" aria-label={es ? "AIR · Inicio" : "AIR · Home"}>AIR<span aria-hidden="true">↗</span></a>
    <div class="nav-links" id="main-navigation">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
    <div class="nav-actions">
      <a href={`${homePath}lab/`} class="nav-laboratory">{es ? "Laboratorio" : "Laboratory"}</a>
      <a href={otherPath} data-astro-reload class="language-link" aria-label={es ? "Switch to English" : "Cambiar a español"}>{es ? "EN" : "ES"}</a>
      <button class="action menu-toggle" type="button" aria-controls="main-navigation" aria-expanded="false" data-menu-toggle>{es ? "Menú" : "Menu"}</button>
    </div>
  </nav>
</header>
<script>
  let disposeHeader: (() => void) | undefined;
  function setupHeader() {
    disposeHeader?.();
    const header = document.querySelector<HTMLElement>("[data-site-header]");
    const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const menu = header?.querySelector<HTMLElement>("#main-navigation");
    if (!header || !toggle || !menu) return;
    header.setAttribute("data-menu-ready", "");
    const controller = new AbortController();
    const close = (returnFocus = false) => {
      header.removeAttribute("data-menu-open");
      toggle.setAttribute("aria-expanded", "false");
      if (returnFocus) toggle.focus();
    };
    toggle.addEventListener("click", () => {
      const open = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(open));
      header.toggleAttribute("data-menu-open", open);
      if (open) menu.querySelector<HTMLAnchorElement>("a")?.focus();
    }, { signal: controller.signal });
    menu.addEventListener("click", (event) => { if ((event.target as Element).closest("a")) close(); }, { signal: controller.signal });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && header.hasAttribute("data-menu-open")) { event.preventDefault(); close(true); }
    }, { signal: controller.signal });
    document.addEventListener("click", (event) => { if (!header.contains(event.target as Node)) close(); }, { signal: controller.signal });
    header.addEventListener("focusout", (event) => {
      if (event.relatedTarget instanceof Node && !header.contains(event.relatedTarget)) close();
    }, { signal: controller.signal });
    disposeHeader = () => controller.abort();
  }
  setupHeader();
  document.addEventListener("astro:page-load", setupHeader);
  document.addEventListener("astro:before-swap", () => disposeHeader?.());
</script>
