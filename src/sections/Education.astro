---
import { education } from "../data/education";
import { getLangFromUrl, t } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const es = lang === "es";
---
<div id="education">
  <h3 class="profile-subtitle">{es ? "Formación" : "Education"}</h3>
  <div class="education-list">{education.filter((entry) => entry.status === "completed").map((entry) => <article><h4>{entry.institution}</h4><p>{es && entry.degreeEs ? entry.degreeEs : entry.degree}</p>{entry.specialization && <p>{entry.specialization}</p>}<p class="education-status">{t("education.status.completed", lang)}</p></article>)}</div>
  <details class="profile-disclosure">
    <summary>{es ? "Más formación" : "Further education"}<span>MIOTI / U-tad</span></summary>
    <div class="education-list">{education.filter((entry) => entry.status !== "completed").map((entry) => <article><h4>{entry.institution}</h4><p>{es && entry.degreeEs ? entry.degreeEs : entry.degree}</p>{entry.specialization && <p>{entry.specialization}</p>}</article>)}</div>
  </details>
</div>
