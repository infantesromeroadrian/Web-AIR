---
import { achievements, htbRanking } from "../data/achievements";
import { COAE_CERTIFICATION, certifications } from "../data/education";
import { getLangFromUrl, t } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const es = lang === "es";
---
<div id="achievements" class="profile-credentials">
  <h3 class="profile-subtitle">{es ? "Certificación y competición" : "Certification and competition"}</h3>
  <ul class="credential-summary">
    <li><strong>{htbRanking.title[lang]}</strong><span>{htbRanking.subtitle[lang]}</span></li>
    <li><strong>{COAE_CERTIFICATION}</strong><span>{t("education.cert.completed", lang)}</span></li>
  </ul>
  <details class="profile-disclosure">
    <summary>{es ? "Más certificaciones y logros" : "More certifications and achievements"}</summary>
    <ul class="credential-list">{certifications.filter((cert) => cert !== COAE_CERTIFICATION).map((cert) => <li>{cert}</li>)}</ul>
    <ul class="credential-list">{achievements.filter((achievement) => achievement.title !== htbRanking.title.en).map((achievement) => <li>{achievement.url ? <a class="text-link" href={achievement.url} target="_blank" rel="noopener noreferrer">{achievement.title}</a> : <strong>{achievement.title}</strong>}<span>{achievement.subtitle}</span></li>)}</ul>
  </details>
</div>
