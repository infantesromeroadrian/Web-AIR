---
import { currentExperience, htbActivity } from "../data/experience";
import { getLangFromUrl, t } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const es = lang === "es";
---
<section id="hero" class="hero-section" aria-labelledby="identity-title">
  <div class="content-wrap">
    <h1 id="identity-title">Adrián Infantes</h1>
    <p class="identity-role">{currentExperience.role} <span>&amp;</span> {htbActivity.role}</p>
    <p class="identity-promise">{es ? "Diseño IA segura. Evalúo cómo puede fallar." : "I design secure AI. I evaluate how it can fail."}</p>
    <p class="identity-context">{es ? "Arquitectura de seguridad de IA en" : "AI security architecture at"} <strong>{currentExperience.company}</strong>. {es ? "Práctica independiente en laboratorios y competición de" : "Independent lab and competition practice on"} <strong>{htbActivity.platform}</strong>.</p>
    <div class="link-row hero-actions">
      <a class="action action-primary" href="#work">{es ? "Ver mi trabajo" : "View my work"}</a>
      <a class="text-link" href="#contact">{t("hero.cta.contact", lang)}</a>
    </div>
  </div>
</section>
