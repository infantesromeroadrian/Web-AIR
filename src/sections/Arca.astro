---
import ScrollReveal from "../components/react/ScrollReveal";
import { getLangFromUrl, t } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);

const highlightArca = (s: string): string =>
  s.replaceAll("A.R.C.A.", '<span class="arca-accent">A.R.C.A.</span>');

const ARCA_LIVE_URL = "https://arca-agent-landing.vercel.app";
const ARCA_REPO_URL = "https://github.com/infantesromeroadrian/arca-claude-code";

const metrics = [
  { value: "49", label: t("arca.metric.agents", lang) },
  { value: "97", label: t("arca.metric.skills", lang) },
  { value: "47", label: t("arca.metric.adrs", lang) },
  { value: "14", label: t("arca.metric.cycles", lang) },
];

const pillars = [
  { title: t("arca.pillar1.title", lang), body: t("arca.pillar1.body", lang) },
  { title: t("arca.pillar2.title", lang), body: t("arca.pillar2.body", lang) },
  { title: t("arca.pillar3.title", lang), body: t("arca.pillar3.body", lang) },
];
---

<!-- openclaw.ai font stack — self-hosted to comply with vercel.json CSP.
     CSP allows font-src 'self' data: and style-src 'self' 'unsafe-inline',
     so Fontshare CDN is blocked. Files served from /fonts/*.woff2. -->
<link rel="stylesheet" href="/fonts/openclaw.css" />

<section id="arca" class="arca-openclaw">
  <div class="arca-inner">
    <ScrollReveal client:visible>
      <p class="arca-eyebrow">
        <span class="arca-mark">&#10217;</span>
        {t("arca.pretitle", lang)}
      </p>
    </ScrollReveal>

    <h2 class="arca-title" set:html={highlightArca(t("arca.title", lang))}></h2>

    <ScrollReveal client:visible delay={0.1}>
      <p class="arca-tagline">{t("arca.tagline", lang)}</p>
    </ScrollReveal>

    <ScrollReveal client:visible delay={0.15}>
      <p
        class="arca-intro"
        set:html={highlightArca(t("arca.intro", lang))}
      ></p>
    </ScrollReveal>

    <ScrollReveal client:visible delay={0.2}>
      <div class="arca-metrics">
        {
          metrics.map((m) => (
            <div class="arca-metric-card">
              <div class="arca-metric-value">{m.value}</div>
              <div class="arca-metric-label">{m.label}</div>
            </div>
          ))
        }
      </div>
    </ScrollReveal>

    <div class="arca-pillars">
      {
        pillars.map((p, i) => (
          <ScrollReveal client:visible delay={0.25 + i * 0.05}>
            <div class="arca-pillar-card">
              <div class="arca-pillar-index">
                {String(i + 1).padStart(2, "0")}
              </div>
              <h3 class="arca-pillar-title">{p.title}</h3>
              <p class="arca-pillar-body">{p.body}</p>
            </div>
          </ScrollReveal>
        ))
      }
    </div>

    <ScrollReveal client:visible delay={0.4}>
      <div class="arca-ctas">
        <a
          class="arca-cta arca-cta-primary"
          href={ARCA_LIVE_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t("arca.cta.live", lang)}
          <span aria-hidden="true" class="arca-arrow">-&gt;</span>
        </a>
        <a
          class="arca-cta arca-cta-ghost"
          href={ARCA_REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t("arca.cta.source", lang)}
          <span aria-hidden="true" class="arca-arrow">-&gt;</span>
        </a>
      </div>
    </ScrollReveal>
  </div>
</section>

<style>
  /* openclaw.ai design system, scoped to #arca */
  .arca-openclaw {
    --oc-bg: #050810;
    --oc-surface: #090e18;
    --oc-border: #191d28;
    --oc-fg: #f0f4ff;
    --oc-fg-muted: rgba(240, 244, 255, 0.62);
    --oc-fg-faint: rgba(240, 244, 255, 0.36);

    background: var(--oc-bg);
    color: var(--oc-fg);
    font-family: "Satoshi", system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: 17.6px;
    line-height: 1.55;
    padding: 6rem 1.5rem;
    position: relative;
    isolation: isolate;
    border-top: 1px solid var(--oc-border);
    border-bottom: 1px solid var(--oc-border);
  }

  .arca-inner {
    max-width: 1120px;
    margin: 0 auto;
  }

  .arca-eyebrow {
    font-family: "Satoshi", system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--oc-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 1.5rem 0;
  }

  .arca-mark {
    color: var(--oc-fg);
    margin-right: 0.5em;
    font-weight: 600;
  }

  .arca-title {
    font-family: "Clash Display", system-ui, sans-serif;
    font-size: clamp(2.5rem, 6.5vw, 4.5rem);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem 0;
    color: var(--oc-fg);
  }

  .arca-accent {
    font-weight: 700;
    color: var(--oc-fg);
  }

  .arca-tagline {
    font-family: "Clash Display", system-ui, sans-serif;
    font-size: clamp(1.15rem, 1.8vw, 1.4rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--oc-fg);
    margin: 0 0 1.25rem 0;
    max-width: 56ch;
  }

  .arca-intro {
    color: var(--oc-fg-muted);
    max-width: 65ch;
    margin: 0;
    font-size: 1rem;
  }

  /* Metrics — 4-card grid */
  .arca-metrics {
    margin-top: 3.5rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .arca-metrics {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .arca-metric-card {
    background: var(--oc-surface);
    border: 1px solid var(--oc-border);
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: none;
    text-align: left;
  }

  .arca-metric-value {
    font-family: "Clash Display", system-ui, sans-serif;
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1;
    color: var(--oc-fg);
  }

  .arca-metric-label {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--oc-fg-muted);
    letter-spacing: 0.01em;
  }

  /* Pillars — 3-card grid */
  .arca-pillars {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .arca-pillars {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .arca-pillar-card {
    background: var(--oc-surface);
    border: 1px solid var(--oc-border);
    border-radius: 12px;
    padding: 1.75rem;
    height: 100%;
    box-shadow: none;
    transition: border-color 200ms ease, background 200ms ease;
  }

  .arca-pillar-card:hover {
    border-color: rgba(240, 244, 255, 0.22);
  }

  .arca-pillar-index {
    font-family: "Satoshi", system-ui, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--oc-fg-faint);
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .arca-pillar-title {
    font-family: "Clash Display", system-ui, sans-serif;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--oc-fg);
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.005em;
  }

  .arca-pillar-body {
    font-size: 0.95rem;
    color: var(--oc-fg-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* CTAs — flat 12px radius, openclaw style */
  .arca-ctas {
    margin-top: 3.5rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .arca-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.85rem 1.5rem;
    font-family: "Satoshi", system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 12px;
    text-decoration: none;
    border: 1px solid var(--oc-border);
    transition:
      background 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
    cursor: pointer;
  }

  .arca-cta-primary {
    background: var(--oc-fg);
    color: var(--oc-bg);
    border-color: var(--oc-fg);
  }

  .arca-cta-primary:hover {
    background: rgba(240, 244, 255, 0.88);
    border-color: rgba(240, 244, 255, 0.88);
  }

  .arca-cta-ghost {
    background: var(--oc-surface);
    color: var(--oc-fg);
  }

  .arca-cta-ghost:hover {
    border-color: rgba(240, 244, 255, 0.32);
  }

  .arca-arrow {
    font-family: "Satoshi", system-ui, sans-serif;
    font-weight: 500;
    transition: transform 180ms ease;
  }

  .arca-cta:hover .arca-arrow {
    transform: translateX(2px);
  }
</style>
