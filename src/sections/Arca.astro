---
import ScrollReveal from "../components/react/ScrollReveal";
import { getLangFromUrl, t } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);

const highlightArca = (s: string): string =>
  s.replaceAll(
    "A.R.C.A.",
    '<span class="font-semibold text-sky-300">A.R.C.A.</span>',
  );

const ARCA_LIVE_URL = "https://arca-agent-landing.vercel.app";
const ARCA_REPO_URL = "https://github.com/infantesromeroadrian/arca-claude-code";

const metrics = [
  { value: "43", label: t("arca.metric.agents", lang) },
  { value: "86", label: t("arca.metric.skills", lang) },
  { value: "14", label: t("arca.metric.cycles", lang) },
];

const pillars = [
  { title: t("arca.pillar1.title", lang), body: t("arca.pillar1.body", lang) },
  { title: t("arca.pillar2.title", lang), body: t("arca.pillar2.body", lang) },
  { title: t("arca.pillar3.title", lang), body: t("arca.pillar3.body", lang) },
];
---

<section
  id="arca"
  class="relative overflow-hidden border-y border-border/40 bg-bg-primary px-6 py-24"
>
  <!-- Subtle scan lines + radial accent, coherent with Hero -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.07] mix-blend-overlay"
    style="background-image: repeating-linear-gradient(0deg, rgba(6,182,212,0.45) 0px, rgba(6,182,212,0.45) 1px, transparent 1px, transparent 4px);"
  ></div>
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(6,182,212,0.10),transparent_60%)]"
  ></div>

  <div class="relative z-10 mx-auto max-w-[var(--max-w-content)]">
    <ScrollReveal client:visible>
      <p
        class="mb-3 font-mono text-xs tracking-[0.3em] text-accent uppercase"
      >
        {t("arca.pretitle", lang)}
      </p>
    </ScrollReveal>

    <div class="mb-12">
      <h2
        class="text-3xl font-bold tracking-tight text-text-primary"
        set:html={highlightArca(t("arca.title", lang))}
      ></h2>
      <div class="mt-4 h-px w-16 bg-accent"></div>
    </div>

    <ScrollReveal client:visible delay={0.1}>
      <p class="max-w-3xl text-xl font-medium leading-snug text-text-primary">
        {t("arca.tagline", lang)}
      </p>
    </ScrollReveal>

    <ScrollReveal client:visible delay={0.15}>
      <p
        class="mt-6 max-w-3xl text-base leading-relaxed text-text-secondary"
        set:html={highlightArca(t("arca.intro", lang))}
      ></p>
    </ScrollReveal>

    <!-- Metrics -->
    <ScrollReveal client:visible delay={0.2}>
      <div class="mt-12 grid grid-cols-3 gap-4 border-t border-b border-border py-8">
        {metrics.map((m) => (
          <div class="flex flex-col items-center text-center">
            <div class="font-mono text-4xl font-bold text-accent sm:text-5xl">
              {m.value}
            </div>
            <div class="mt-2 text-xs uppercase tracking-widest text-text-muted">
              {m.label}
            </div>
          </div>
        ))}
      </div>
    </ScrollReveal>

    <!-- Pillars -->
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {pillars.map((p, i) => (
        <ScrollReveal client:visible delay={0.25 + i * 0.05}>
          <div
            class="h-full rounded-lg border border-border bg-bg-secondary/40 p-6 transition-colors hover:border-accent/60"
          >
            <div class="mb-3 font-mono text-xs tracking-[0.2em] text-accent/80 uppercase">
              {String(i + 1).padStart(2, "0")}
            </div>
            <h3 class="mb-2 text-lg font-semibold text-text-primary">
              {p.title}
            </h3>
            <p class="text-sm leading-relaxed text-text-secondary">{p.body}</p>
          </div>
        </ScrollReveal>
      ))}
    </div>

    <!-- CTAs -->
    <ScrollReveal client:visible delay={0.4}>
      <div class="mt-12 flex flex-col gap-4 sm:flex-row">
        <a
          href={ARCA_LIVE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-2 rounded-md border border-accent bg-accent px-6 py-3 text-sm font-semibold tracking-wide text-bg-primary transition-opacity hover:opacity-90"
        >
          {t("arca.cta.live", lang)}
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">
            -&gt;
          </span>
        </a>
        <a
          href={ARCA_REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 rounded-md border border-border px-6 py-3 text-sm font-semibold tracking-wide text-text-primary transition-colors hover:border-accent hover:text-accent"
        >
          {t("arca.cta.source", lang)}
        </a>
      </div>
    </ScrollReveal>
  </div>
</section>
