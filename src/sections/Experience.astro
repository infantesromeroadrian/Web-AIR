---
import { currentExperience, experience, htbActivity } from "../data/experience";
import { getLangFromUrl } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const es = lang === "es";
---
<div id="experience" class="profile-experience">
  <h3 class="profile-subtitle">{es ? "Experiencia y práctica" : "Experience and practice"}</h3>
  <article class="profile-position">
    <h4>{currentExperience.role}</h4>
    <p class="position-organization">{currentExperience.company}</p>
    <p class="position-meta">{currentExperience.period} · {currentExperience.location}</p>
    <p>{es ? "Arquitectura de AI Safety para entornos financieros, con seguridad integrada en el ciclo de desarrollo." : currentExperience.headline}</p>
    <details class="details-block"><summary>{es ? "Responsabilidades actuales" : "Current responsibilities"}</summary><p>{currentExperience.description}</p><ul class="list-disc pl-5 space-y-2">{currentExperience.highlights.map((highlight) => <li>{highlight}</li>)}</ul><div class="tag-list">{currentExperience.tags.map((tag) => <span>{tag}</span>)}</div></details>
  </article>
  <article class="profile-position">
    <h4>{htbActivity.role}</h4>
    <p class="position-organization">{htbActivity.platform}</p>
    <p>{htbActivity.scope[lang]}.</p>
    <details class="details-block"><summary>{es ? "Alcance de la práctica" : "Practice scope"}</summary><p>{htbActivity.description[lang]}</p><div class="tag-list">{htbActivity.tags.map((tag) => <span>{tag}</span>)}</div></details>
  </article>
  <details class="profile-disclosure">
    <summary>{es ? "Trayectoria anterior" : "Previous experience"}<span>2019–2026</span></summary>
    <div class="career-history">{experience.slice(1).map((exp) => <article>
      <h4>{exp.role}</h4><p class="position-organization">{exp.company}</p><p class="position-meta">{exp.period} · {exp.location}</p><p>{exp.headline}</p><p>{exp.description}</p>
      <ul class="list-disc pl-5 space-y-2">{exp.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
      {exp.impact.length > 0 && <ul class="career-metrics">{exp.impact.map((metric) => <li><strong>{metric.value}</strong> {metric.label}</li>)}</ul>}
      <div class="tag-list">{exp.tags.map((tag) => <span>{tag}</span>)}</div>
    </article>)}</div>
  </details>
</div>
