---
import SectionTitle from "../components/astro/SectionTitle.astro";
import { experience } from "../data/experience";
import { getLangFromUrl, t } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
---
<section id="experience" class="content-section"><div class="content-wrap">
  <SectionTitle title={t("experience.title", lang)} subtitle={t("experience.subtitle", lang)} />
  {experience.map((exp) => <article class="experience-row">
    <div><p class="text-accent font-medium">{exp.company}</p><p class="mt-2 text-sm">{exp.period}</p><p class="mt-1 text-sm">{exp.location}</p></div>
    <div><h3>{exp.role}</h3><p class="mt-3">{exp.headline}</p>
      {exp.impact.length > 0 && <div class="experience-metrics">{exp.impact.map((metric) => <span><strong>{metric.value}</strong>{metric.label}</span>)}</div>}
      <details class="details-block mt-3"><summary>{t("experience.tech", lang)}</summary><p>{exp.description}</p><ul class="list-disc pl-5 space-y-2 text-text-secondary">{exp.highlights.map((highlight) => <li>{highlight}</li>)}</ul><div class="tag-list">{exp.tags.map((tag) => <span>{tag}</span>)}</div></details>
    </div>
  </article>)}
</div></section>
