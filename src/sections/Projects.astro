---
import SectorTabs from "../components/react/SectorTabs";
import { sectors } from "../data/projects";
import { getLangFromUrl } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const localizedSectors = sectors.map((sector) => ({
  ...sector,
  projects: sector.projects.map((project) =>
    lang === "es" && project.descriptionEs
      ? {
          ...project,
          description: project.descriptionEs,
          ...(project.slug && { detailsUrl: `/es/projects/${project.slug}` }),
        }
      : project,
  ),
}));
---

<section id="projects" class="catalog-section" aria-label={lang === "es" ? "Todos los proyectos" : "All projects"}>
  <div class="content-wrap">
    <SectorTabs client:visible sectors={localizedSectors} lang={lang} />
  </div>
</section>
