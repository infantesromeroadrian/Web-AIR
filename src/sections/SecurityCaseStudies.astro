---
import { SECURITY_WORK_ORGANIZATION, securityCaseStudies } from "../data/security-case-studies";
import { getLangFromUrl, t } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const es = lang === "es";
---
<div id="security-work" class="enterprise-work">
  <h3 class="subsection-title">{es ? "Contribuciones empresariales" : "Enterprise contributions"}</h3>
  {securityCaseStudies.map((study) => <article class="case-row" aria-labelledby={`${study.id}-title`}>
    <div class="case-intro">
      <p class="case-context">{SECURITY_WORK_ORGANIZATION[lang]}</p>
      <h4 id={`${study.id}-title`}>{study.title[lang]}</h4>
    </div>
    <div class="case-evidence">
      <p class="case-contribution">{study.contribution[lang]}</p>
      <p class="case-date">{t("securityWork.milestone", lang)} · <time datetime={study.milestoneDate}>{study.milestoneLabel[lang]}</time></p>
      <ul class="case-outcomes">{study.outcomes[lang].map((outcome) => <li>{outcome}</li>)}</ul>
      <p class="case-boundary"><strong>{t("securityWork.boundary", lang)}.</strong> {study.boundary[lang]}</p>
      <details class="details-block">
        <summary>{es ? "Controles y detalle técnico" : "Controls and technical detail"}</summary>
        <ul class="list-disc pl-5 space-y-2 text-text-secondary">{study.controls[lang].map((control) => <li>{control}</li>)}</ul>
        <div class="tag-list">{study.tags.map((tag) => <span>{tag}</span>)}</div>
      </details>
    </div>
  </article>)}
</div>
