---
import { Image } from "astro:assets";
import profileImage from "../../assets/Gemini_Generated_Image_ne74yhne74yhne74.png";
import { getLangFromUrl } from "../i18n/utils";
const es = getLangFromUrl(Astro.url) === "es";
---
<div id="about" class="profile-intro">
  <Image src={profileImage} width={96} height={120} alt="Adrián Infantes" loading="lazy" />
  <div><p>{es ? "Más de 6 años construyendo sistemas de IA, desde pipelines de datos y visión artificial hasta arquitectura de seguridad y evaluación adversarial." : "Over 6 years building AI systems, from data pipelines and computer vision to security architecture and adversarial evaluation."}</p><p>{es ? "Madrid, España" : "Madrid, Spain"}</p></div>
</div>
