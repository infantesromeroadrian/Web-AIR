---
import ScrollReveal from "../components/react/ScrollReveal";
import { getLangFromUrl, t } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);

/* Inline highlight of the brand wordmark for ::html injection. */
const highlightBrand = (s: string): string =>
  s
    .replaceAll("A.R.C.A", '<span class="ares-accent">A.R.C.A</span>')
    .replaceAll("ARES", '<span class="ares-accent">A.R.C.A</span>');

const ARCA_LIVE_URL = "https://arca-agent-landing.vercel.app";
const ARCA_REPO_URL = "https://github.com/infantesromeroadrian/arca-claude-code";

const metrics = [
  { value: "49", label: t("arca.metric.agents", lang) },
  { value: "97", label: t("arca.metric.skills", lang) },
  { value: "47", label: t("arca.metric.adrs", lang) },
  { value: "14", label: t("arca.metric.cycles", lang) },
];

const pillars = [
  { title: t("arca.pillar1.title", lang), body: t("arca.pillar1.body", lang) },
  { title: t("arca.pillar2.title", lang), body: t("arca.pillar2.body", lang) },
  { title: t("arca.pillar3.title", lang), body: t("arca.pillar3.body", lang) },
];
---

<!-- Self-hosted openclaw fonts (CSP-compliant via Web-AIR vercel.json) -->
<link rel="stylesheet" href="/fonts/openclaw.css" />

<section id="arca" class="ares-section">
  <div class="ares-aurora" aria-hidden="true"></div>

  <div class="ares-inner">
    <div class="ares-hero-grid">
      <div>
        <ScrollReveal client:visible>
          <p class="ares-eyebrow">
            <span class="ares-mark">&#10217;</span>
            {t("arca.pretitle", lang)}
          </p>
        </ScrollReveal>

        <div class="ares-wordmark-row">
          <span class="ares-wordmark">A.R.C.A</span>
        </div>

        <h2 class="ares-title" set:html={highlightBrand(t("arca.title", lang))}></h2>

        <ScrollReveal client:visible delay={0.1}>
          <p class="ares-tagline">{t("arca.tagline", lang)}</p>
        </ScrollReveal>

        <ScrollReveal client:visible delay={0.15}>
          <p
            class="ares-intro"
            set:html={highlightBrand(t("arca.intro", lang))}
          ></p>
        </ScrollReveal>
      </div>

      <!-- A.R.C.A samurai chibi — visual identity asset -->
      <div class="ares-portrait-wrap">
        <img
          src="/arca-hero.png"
          alt="A.R.C.A — AI Research & Code Architect"
          loading="lazy"
          decoding="async"
          class="ares-portrait"
        />
        <div class="ares-portrait-glow" aria-hidden="true"></div>
      </div>
    </div>

    <ScrollReveal client:visible delay={0.2}>
      <div class="ares-metrics">
        {
          metrics.map((m) => (
            <div class="ares-metric-card">
              <div class="ares-metric-value">{m.value}</div>
              <div class="ares-metric-label">{m.label}</div>
            </div>
          ))
        }
      </div>
    </ScrollReveal>

    <div class="ares-pillars">
      {
        pillars.map((p, i) => (
          <ScrollReveal client:visible delay={0.25 + i * 0.05}>
            <div class="ares-pillar-card">
              <div class="ares-pillar-index">{String(i + 1).padStart(2, "0")}</div>
              <h3 class="ares-pillar-title">{p.title}</h3>
              <p class="ares-pillar-body">{p.body}</p>
            </div>
          </ScrollReveal>
        ))
      }
    </div>

    <ScrollReveal client:visible delay={0.4}>
      <div class="ares-ctas">
        <a
          class="ares-cta ares-cta-primary"
          href={ARCA_LIVE_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t("arca.cta.live", lang)}
          <span aria-hidden="true" class="ares-arrow">-&gt;</span>
        </a>
        <a
          class="ares-cta ares-cta-ghost"
          href={ARCA_REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
        >
          {t("arca.cta.source", lang)}
          <span aria-hidden="true" class="ares-arrow">-&gt;</span>
        </a>
      </div>
    </ScrollReveal>
  </div>
</section>

<style>
  /* A.R.C.A identity — scoped to #arca within Web-AIR.
     Deep blue bg + samurai blue accent + cyan highlights + sky fg.
     Palette derived from the A.R.C.A samurai chibi visual identity. */
  .ares-section {
    --ares-bg: #0a1226;
    --ares-surface: #0f1c3a;
    --ares-border: #1e3a6e;
    --ares-fg: #e0ecff;
    --ares-fg-muted: rgba(224, 236, 255, 0.62);
    --ares-fg-faint: rgba(224, 236, 255, 0.36);
    --ares-magenta: #2563eb;
    --ares-fuchsia: #3b82f6;
    --ares-blush: #93c5fd;
    --ares-shadow: #020410;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--ares-bg);
    color: var(--ares-fg);
    font-family: "Satoshi", system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: 17.6px;
    line-height: 1.55;
    padding: 6rem 1.5rem;
    border-top: 1px solid var(--ares-border);
    border-bottom: 1px solid var(--ares-border);
  }

  /* Aurora glow — radial blue + deep blue + cyan at top */
  .ares-aurora {
    position: absolute;
    inset: -10% -5% 30% -5%;
    z-index: -1;
    background:
      radial-gradient(ellipse 55% 45% at 50% 0%, rgba(37, 99, 235, 0.32), transparent 65%),
      radial-gradient(ellipse 40% 35% at 25% 10%, rgba(30, 58, 110, 0.32), transparent 60%),
      radial-gradient(ellipse 38% 32% at 78% 20%, rgba(59, 130, 246, 0.20), transparent 60%);
    filter: blur(40px);
    pointer-events: none;
  }

  .ares-inner {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: 0 auto;
  }

  .ares-hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .ares-hero-grid {
      grid-template-columns: 1fr auto;
      gap: 3.5rem;
    }
  }

  .ares-eyebrow {
    font-family: "Satoshi", system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ares-fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    margin: 0 0 1.5rem 0;
  }

  .ares-mark {
    color: var(--ares-fg);
    margin-right: 0.5em;
    font-weight: 600;
  }

  /* Wordmark with magenta+violet glow */
  .ares-wordmark-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .ares-wordmark {
    font-family: "Clash Display", system-ui, sans-serif;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ares-fg);
    text-shadow:
      0 0 24px rgba(37, 99, 235, 0.55),
      0 0 64px rgba(30, 58, 110, 0.45);
  }

  .ares-version {
    display: none;
    font-family: "Satoshi", system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--ares-fg-faint);
  }

  @media (min-width: 768px) {
    .ares-version {
      display: inline;
    }
  }

  .ares-title {
    font-family: "Clash Display", system-ui, sans-serif;
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 1.5rem 0;
    color: var(--ares-fg);
  }

  .ares-accent {
    font-weight: 700;
    color: var(--ares-magenta);
  }

  .ares-tagline {
    font-family: "Clash Display", system-ui, sans-serif;
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--ares-fg);
    margin: 0 0 1.25rem 0;
    max-width: 56ch;
  }

  .ares-intro {
    color: var(--ares-fg-muted);
    max-width: 65ch;
    margin: 0;
    font-size: 1rem;
  }

  /* Ares portrait */
  .ares-portrait-wrap {
    position: relative;
    justify-self: center;
  }

  .ares-portrait {
    display: block;
    width: 100%;
    max-width: 340px;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--ares-border);
    object-fit: cover;
    box-shadow: 0 0 60px rgba(37, 99, 235, 0.25);
  }

  .ares-portrait-glow {
    position: absolute;
    inset: -20%;
    z-index: -1;
    background: radial-gradient(
      ellipse at center,
      rgba(37, 99, 235, 0.18),
      transparent 60%
    );
    filter: blur(30px);
    pointer-events: none;
  }

  /* Metrics — 4 cards */
  .ares-metrics {
    margin-top: 3.5rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .ares-metrics {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .ares-metric-card {
    background: var(--ares-surface);
    border: 1px solid var(--ares-border);
    border-radius: 12px;
    padding: 1.5rem;
    text-align: left;
  }

  .ares-metric-value {
    font-family: "Clash Display", system-ui, sans-serif;
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 600;
    line-height: 1;
    color: var(--ares-magenta);
  }

  .ares-metric-label {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--ares-fg-muted);
    letter-spacing: 0.01em;
  }

  /* Pillars — 3 cards */
  .ares-pillars {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .ares-pillars {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .ares-pillar-card {
    background: var(--ares-surface);
    border: 1px solid var(--ares-border);
    border-radius: 12px;
    padding: 1.75rem;
    height: 100%;
    transition: border-color 200ms ease;
  }

  .ares-pillar-card:hover {
    border-color: rgba(37, 99, 235, 0.45);
  }

  .ares-pillar-index {
    font-family: "Satoshi", system-ui, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--ares-fuchsia);
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .ares-pillar-title {
    font-family: "Clash Display", system-ui, sans-serif;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--ares-fg);
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.005em;
  }

  .ares-pillar-body {
    font-size: 0.95rem;
    color: var(--ares-fg-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* CTAs */
  .ares-ctas {
    margin-top: 3.5rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .ares-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.85rem 1.5rem;
    font-family: "Satoshi", system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 12px;
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      transform 160ms ease;
    cursor: pointer;
  }

  .ares-cta:active {
    transform: scale(0.97);
  }

  .ares-cta-primary {
    background: var(--ares-magenta);
    color: var(--ares-bg);
    border-color: var(--ares-magenta);
  }

  .ares-cta-primary:hover {
    background: var(--ares-fuchsia);
    border-color: var(--ares-fuchsia);
  }

  .ares-cta-ghost {
    background: var(--ares-surface);
    color: var(--ares-fg);
    border-color: var(--ares-border);
  }

  .ares-cta-ghost:hover {
    border-color: var(--ares-magenta);
    color: var(--ares-magenta);
  }

  .ares-arrow {
    font-family: "Satoshi", system-ui, sans-serif;
    font-weight: 500;
    transition: transform 180ms ease;
  }

  .ares-cta:hover .ares-arrow {
    transform: translateX(2px);
  }
</style>
