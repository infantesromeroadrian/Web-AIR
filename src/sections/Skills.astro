---
import { skills } from "../data/skills";
import { getLangFromUrl } from "../i18n/utils";
const es = getLangFromUrl(Astro.url) === "es";
---
<details id="skills" class="profile-disclosure profile-skills">
  <summary>{es ? "Herramientas y competencias" : "Tools and skills"}<span>AI Security / LLMs / ML / Cloud</span></summary>
  <div class="skill-grid">{skills.map((category) => <div><h4>{category.name}</h4><div class="tag-list">{category.skills.map((skill) => <span>{skill}</span>)}</div></div>)}</div>
</details>
