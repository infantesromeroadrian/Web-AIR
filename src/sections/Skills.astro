---
import SectionTitle from "../components/astro/SectionTitle.astro";
import { skills } from "../data/skills";
import { getLangFromUrl, t } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
---
<section id="skills" class="content-section"><div class="content-wrap">
  <SectionTitle title={t("skills.title", lang)} subtitle={t("skills.subtitle", lang)} />
  <div class="skill-grid">{skills.map((category) => <article><h3>{category.name}</h3><div class="tag-list">{category.skills.map((skill) => <span>{skill}</span>)}</div></article>)}</div>
</div></section>
