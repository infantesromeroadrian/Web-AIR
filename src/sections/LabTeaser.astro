---
import { getLangFromUrl } from "../i18n/utils";
const es = getLangFromUrl(Astro.url) === "es";
const base = es ? "/es/" : "/";
const lab = `${base}lab/`;
---
<aside id="lab" class="lab-teaser" aria-label={es ? "Explorar el laboratorio" : "Explore the laboratory"}>
  <p>{es ? "En el laboratorio: sistemas de agentes, experimentos visuales, el asistente de IA y el terminal del perfil." : "In the laboratory: agent systems, visual experiments, the AI assistant and profile terminal."}</p>
  <div class="lab-links"><a class="text-link" href={lab}>{es ? "Abrir laboratorio" : "Open laboratory"}</a><a class="text-link" id="arca" href={`${lab}#arca`}>ARCA</a><a class="text-link" id="attacks" href={`${lab}#attacks`}>{es ? "Visualizaciones" : "Visualizations"}</a><a class="text-link" id="job-match" href={`${lab}#job-match`}>Job Match</a><a class="text-link" id="github" href={`${lab}#github`}>GitHub</a><a class="text-link" href={`${base}roadmap`}>Roadmap</a></div>
</aside>
